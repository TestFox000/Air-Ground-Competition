# ==============================================================================
#  无人机侧链路环境（★ 唯一真相源，两处必须一致）
#    本文件 → 无人机 ~/dzlink_tools/dzlink.env
#    对应   → 小车 ~/dzrobot/start_all.sh 里的 DZ_ROS_DOMAIN
#
#  为什么要有这个文件：
#    2026-10-07 联调事故 —— 小车从【交互式终端】起栈会读 ~/.bashrc（域 118），
#    而无人机侧 ~ 下一处都没设过（默认域 0）。两边域号不同时：
#      ping 通、SSH 通、网页台 :8080 通，但 ROS 死活看不见对方，
#      而且【一个错都不报】。排查白白花了一整轮。
#
#  dz_send_waypoint.py 在 import 阶段自动读本文件（晚于 rclpy.init 就无效）。
#  想临时 A/B 别的域号：直接改这里，或 ROS_DOMAIN_ID=200 python3 ...（会被报警提示）
# ==============================================================================
export ROS_DOMAIN_ID=118
export ROS_LOCALHOST_ONLY=0
