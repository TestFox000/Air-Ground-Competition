# ==============================================================================
#  ★ ROS 链路环境：全车唯一真相源（2026-10-07 无人机↔小车联调事故）
#
#  任何"起 ROS 节点 / 跑 ros2 命令"的脚本都应该 source 本文件，不要各自写死域号。
#  对应文件：无人机侧 ~/dzlink_tools/dzlink.env —— 两边域号必须一致。
#
#  为什么必须这样：
#    · 交互式终端起栈                → 会读 ~/.bashrc → 118
#    · systemd / cron / ssh 一行命令  → 不读 ~/.bashrc → 默认 0
#    两种起法域号不同时：ping 通、SSH 通、网页台 :8080 通，
#    但 ROS 死活看不见对方，而且【一个错都不报】。
#
#  改域号：只改本文件（+ 无人机侧 dzlink.env），全车所有入口自动跟随。
#  外部已显式 export 的 ROS_DOMAIN_ID 仍然优先（临时 A/B 用），启动横幅会报警。
# ==============================================================================
DZ_ROS_DOMAIN="${DZ_ROS_DOMAIN:-118}"
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-$DZ_ROS_DOMAIN}"
export ROS_LOCALHOST_ONLY="${ROS_LOCALHOST_ONLY:-0}"
