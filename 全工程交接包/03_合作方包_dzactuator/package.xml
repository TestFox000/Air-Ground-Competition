<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dzactuator</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="duzhong01@todo.todo">duzhong01</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- ★ 下面两个是 ROS 1 时代的包，ROS 2 里不存在，会导致 colcon 构建失败：
         <depend>tf</depend>                 -> ROS 2 用 tf2（上面已声明）
         <depend>actionlib</depend>           -> ROS 2 用 actionlib_msgs / rclcpp_action
         <depend>message_generation</depend>  -> ROS 2 用 rosidl_default_generators
         <depend>tf</depend> 已确认代码零引用（搜过 *.cpp/*.hpp/*.py）。
         注意 tf2 / tf2_msgs / tf2_ros / tf2_geometry_msgs 是 ROS 2 的包，保留。 -->

  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
