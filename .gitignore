# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.venv/
venv/

# ROS2 / colcon
build/
install/
log/
*.bag
ros2_ws/

# 模型与数据：体积大、多为官方 SDK 产物，默认不入库
#
# 注意这里是 `models/*` 而不是 `models/` —— 目录整体被排除后，
# 子目录的否定规则（!models/release/）**不会生效**，这是 Git 的经典陷阱。
models/*
# 例外：正式发布、双方共用的成品模型**必须入库** —— 只有几 MB，值得。
# 这样"两台机器用的不是同一个模型"这件事，从机制上就不可能发生（见 docs/协作看板.md §5）。
!models/release/

# 散落在别处的模型文件一律不入库 —— 只认 models/release/ 这一处
*.rknn
*.onnx
!models/release/*.rknn
!models/release/*.onnx
!tools/samples/*.jsonl

# 现场抓包 / 标定产物
capture/
calib/

# 从车端取回的黑匣子日志与复盘报告（运行时数据，不入库）
# 取回方法见 docs/调试日志.md
logs/

# 从车端取回的厂家源码：只作接口参照，不是我们的代码，不入库
# （需要时用 tools/remote_run.py --get 重新拉取，方法见 docs/实机接口对照.md）
reference/

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store

# 部署用的源码压缩包（tools/car_unzip_src.sh 配套，临时产物，不入库）
src.zip
