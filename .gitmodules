[submodule "dzsmartscout/src/mavros"]
	path = dzsmartscout/src/mavros
	url = https://github.com/mavlink/mavros.git
	branch = ros2
[submodule "dzsmartscout/src/FASTLIO2_ROS2"]
	path = dzsmartscout/src/FASTLIO2_ROS2
	url = https://github.com/liangheming/FASTLIO2_ROS2.git
	branch = main
[submodule "dzsmartscout/src/FAST_LIO_LOCALIZATION_ROS2"]
	path = dzsmartscout/src/FAST_LIO_LOCALIZATION_ROS2
	url = https://github.com/HKUST-Aerial-Robotics/FAST_LIO_LOCALIZATION.git
[submodule "dzsmartscout/src/livox_ros_driver2"]
	path = dzsmartscout/src/livox_ros_driver2
	url = https://github.com/Livox-SDK/livox_ros_driver2.git
[submodule "dzsmartscout/src/px4_msgs"]
	path = dzsmartscout/src/px4_msgs
	url = https://github.com/PX4/px4_msgs.git
[submodule "dzsmartscout/src/px4_ros_com"]
	path = dzsmartscout/src/px4_ros_com
