#!/usr/bin/env python3
"""detect.py 外挂脚本模板 —— 重命名为 detect.py 即被应用接管目标识别阶段。

约定：
  --meta   meta.json 路径（输入：视频元数据）
  --video  原始视频文件路径（输入）
  --out    detections.json 输出路径

把你们真实的离线识别逻辑（如 YOLO/RT-DETR 本地权重推理）填进 run()，
保持输出 JSON 结构不变即可无缝接入。
"""
import argparse
import json


def run(meta: dict, video_path: str) -> dict:
    # TODO: 替换为真实推理。示例：返回一帧一个静态框。
    return {
        "frames": [
            {
                "t": 0.0,
                "boxes": [
                    {"track": 101, "cls": "vehicle", "conf": 0.9,
                     "x": 0.4, "y": 0.4, "w": 0.08, "h": 0.1}
                ],
            }
        ]
    }


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--meta", required=True)
    ap.add_argument("--video", required=True)
    ap.add_argument("--out", required=True)
    args = ap.parse_args()
    with open(args.meta, "r", encoding="utf-8") as f:
        meta = json.load(f)
    result = run(meta, args.video)
    with open(args.out, "w", encoding="utf-8") as f:
        json.dump(result, f, ensure_ascii=False)


if __name__ == "__main__":
    main()
